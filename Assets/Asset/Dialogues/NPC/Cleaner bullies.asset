  - id: oversight
    speakerNameSource: 0
    speakerName: cleaner bullies
    characterProfile: {fileID: 0}
    dialogueLines:
    - text: "Hey listen. We\u2019ve got you surrounded. You really think you can
        do anything against us?"
      voice: 1
      selectedVoice: am_echo
      wav: {fileID: 8300000, guid: bb7e32637d1caf2429e67df8c9b7d0da, type: 3}
      generatedFingerprint: 5707e4a90af40337b45fdb2a5949a4f5
      generatedWavPath: Assets/GeneratedAudio/Dialogues/Cleaner_bullies_6374c687/01_oversight_00_am_echo.wav
    options:
    - text: "No, you listen. We\u2019ve got eyes on you. Try anything funny on me,
        and you think you\u2019ll get off scot-free? Don\u2019t forget who the watchers
        are. "
      objectsToGive: []
      takeInRequirement: 0
      requirement: {fileID: 0}
      trueNextNodeId: 
      falseNextNodeId: 
      nextNodeId: oversight2
      endsConversation: 0
      jumpToScene: 0
      sceneIndex: 
