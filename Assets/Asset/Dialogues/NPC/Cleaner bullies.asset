  - id: oversight2
    speakerNameSource: 0
    speakerName: cleaner bullies
    characterProfile: {fileID: 0}
    dialogueLines:
    - text: "\u2026We\u2019ve had enough of you creepers! It\u2019s not enough that
        we\u2019re the scum of the pond in this damn company, and now you\u2019re
        trying to take away what we\u2019ve carved out for ourselves?\r\n"
      voice: 1
      selectedVoice: am_echo
      wav: {fileID: 8300000, guid: 99c4b948bfacaba4da1e99a06855a906, type: 3}
      generatedFingerprint: 57a0c20096c92504da0d00d61c6c1dbb
      generatedWavPath: Assets/GeneratedAudio/Dialogues/Cleaner_bullies_6374c687/02_oversight2_00_am_echo.wav
    options:
    - text: "Oh, and you\u2019re completely innocent victims? There comes a point
        where corporate can\u2019t turn a blind eye anymore. "
      objectsToGive: []
      takeInRequirement: 0
      requirement: {fileID: 0}
      trueNextNodeId: 
      falseNextNodeId: 
      nextNodeId: oversight3
      endsConversation: 0
      jumpToScene: 0
      sceneIndex: 
    - text: "Good that you know what your position in this company is. If you want
        to at least stay in this pond\u2026 "
      objectsToGive: []
      takeInRequirement: 0
      requirement: {fileID: 0}
      trueNextNodeId: 
      falseNextNodeId: 
      nextNodeId: oversight3
      endsConversation: 0
      jumpToScene: 0
